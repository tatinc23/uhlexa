# Uhlexa environment contract. Copy to .env (git-ignored) and fill in; never commit real values.
# A provider is active only when its ENABLE_* flag is true AND its credential is set.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Docker compose overrides this to point at its own db service.
DATABASE_URL=postgresql+psycopg://uhlexa:uhlexa@localhost:5433/uhlexa
# Required (non-default) when APP_ENV=production. Signs the demo-auth cookie.
APP_SESSION_SECRET=
SECRET_ENCRYPTION_KEY=

ENABLE_DEMO_AUTH=true
ENABLE_APPROVALS=true

ENABLE_PRIMITIVE=false
PRIMITIVE_API_KEY=
PRIMITIVE_API_BASE_URL=

ENABLE_SUBQ_SNAP=false
SUBQ_API_KEY=
SUBQ_DECISIONS_BASE_URL=https://api.subq.ai/v1
SUBQ_SNAP_MODEL=subq-snap-preview

ENABLE_MARITIME=false
MARITIME_COMPUTERS_KEY=
MARITIME_MCP_URL=https://mcp.maritime.sh/mcp

# Out of scope for this build: the flags exist, there are no adapters.
ENABLE_RING=false
ENABLE_FIRETV=false

# Keiki is the LLM brain (addendum 21.6). Active only with ENABLE_KEIKI=true AND KEIKI_GATEWAY_KEY AND KEIKI_AGENT_IDS.
ENABLE_KEIKI=false
KEIKI_API_BASE_URL=https://onkeiki.com
# A Keiki API key with the `agents:chat` scope (Keiki Settings, API keys). Secret.
KEIKI_GATEWAY_KEY=
# JSON map of Uhlexa user handle -> Keiki agent id, e.g. {"alex":"<agent id>","jordan":"<agent id>"}
KEIKI_AGENT_IDS=
KEIKI_GATEWAY_TIMEOUT_S=120
# Gateway reasoning_effort for calls: none|minimal|low|medium|high
KEIKI_CALL_REASONING=none
# Gateway calls per day before Uhlexa refuses (protects Keiki credits)
KEIKI_DAILY_TURN_CAP=200
# Admin scripts only (scripts/keiki_tokens.py etc.); the running app does not need it. Secret.
KEIKI_API_KEY=

# Inkbox carries iMessage, SMS, email and calls (addendum 21.5). A channel needs ENABLE_INKBOX and its own switch.
ENABLE_INKBOX=false
ENABLE_INKBOX_IMESSAGE=false
ENABLE_INKBOX_SMS=false
ENABLE_INKBOX_EMAIL=false
ENABLE_INKBOX_CALLS=false
INKBOX_API_KEY=
INKBOX_BASE_URL=https://inkbox.ai
# JSON map of Inkbox identity handle -> webhook signing key (shown once in the Inkbox console). Secret.
INKBOX_SIGNING_KEYS=
# Optional second factor for webhooks (sent as a bearer token). Secret.
INKBOX_WEBHOOK_AUTH_TOKEN=

# One agent reaching another household member by text or call (addendum 21.5, 21.8). Everything is off by default.
ENABLE_OUTBOUND_CONTACT=false
ENABLE_OUTBOUND_CALLS=false
# Limits are per sender; the household cap is 3x.
OUTBOUND_TEXTS_PER_HOUR=6
OUTBOUND_CALLS_PER_HOUR=2
OUTBOUND_PER_DAY=20
# Accept "APPROVE <code>" / "DENY <code>" texts from a verified adult owner.
ENABLE_CHANNEL_APPROVALS=false

# --- Uhlexa extras ---
PRIMITIVE_WEBHOOK_SECRET=
# SubQ Snap choices below this confidence are ignored (the deterministic fallback decides). 0.0-1.0.
SUBQ_MIN_CONFIDENCE=0.6
# Run the job worker inside the api process (single-container hosting such as Manufact).
EMBEDDED_WORKER=false
# Seed the demo household on startup (development) and in the container entrypoint.
SEED_DEMO_DATA=true
DEMO_DEFAULT_USER=alex
# The one known-safe public page the Maritime demo task may drive. Empty until chosen.
MARITIME_SAFE_TARGET_URL=
# Used for webhook registration and takeover return links.
PUBLIC_BASE_URL=http://localhost:8000
# Extra Host headers /mcp accepts besides localhost, the PUBLIC_BASE_URL host and uhlexa.inkboxwire.com (comma separated).
MCP_ALLOWED_HOSTS=

# --- Voice + avatar (spec section 22; docs/VOICE.md). Off by default; the worker runs from scripts/voice_worker.sh ---
ENABLE_VOICE=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_AGENT_NAME=uhlexa-voice
# livekit = LiveKit Inference (no extra key; billed to the LiveKit project). openai/groq need their own keys.
VOICE_STT_PROVIDER=livekit
VOICE_STT_MODEL=deepgram/nova-3
VOICE_TTS_PROVIDER=livekit
VOICE_TTS_MODEL=cartesia/sonic-3
GROQ_API_KEY=
OPENAI_API_KEY=
VOICE_TTS_VOICE=
# Per-person voices, JSON handle -> voice id (falls back to VOICE_TTS_VOICE): {"alex":"<id>","katie":"<id>"}
VOICE_TTS_VOICES=
VOICE_DEFAULT_WAKE_MODE=follow_up
VOICE_FOLLOW_UP_S=8
ENABLE_AVATAR=false
RUNWAYML_API_SECRET=
RUNWAY_AVATAR_ID=
RUNWAY_PRESET_ID=
AVATAR_MAX_DURATION_S=300
VOICE_IDLE_CLOSE_S=120
VOICE_DAILY_TURN_CAP=150
# Voice also needs the Keiki gateway (addendum 21.6): ENABLE_KEIKI, KEIKI_GATEWAY_KEY, KEIKI_AGENT_IDS, KEIKI_CALL_REASONING

# --- Hosting on this Mac behind the Inkbox tunnel (docs/HOSTING.md; replaces Manufact) ---
INKBOX_TUNNEL_HANDLE=uhlexa
# Neon pooled URL; scripts/run_public.sh uses it when DATABASE_URL is unset
NEON_DATABASE_URL=
# Access link token for the public URL; generated by scripts/run_public.sh when empty
DEMO_ACCESS_TOKEN=
